VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Caminho onde o app vai ser servido (deixe em branco se for na raiz do
# domínio). Se você serve em http://SEU-IP/interfone/, defina:
#   VITE_BASE_PATH=/interfone/
# (com barra no início E no final). Sem isso, os arquivos JS/CSS não são
# encontrados e a página fica em branco.
VITE_BASE_PATH=
VITE_COMPANY_NAME=Acme Distribuidora
VITE_PBX_NAME=PBX Matriz

# Logo customizado (opcional): coloque o arquivo em frontend/public/logo.png
# (ou .svg) e aponte o caminho abaixo. Deixe em branco para usar o ícone
# padrão. Aparece no painel público, no painel logado e na tela de login.
VITE_LOGO_URL=
