# Porta HTTP do backend
PORT=3001

# CORS: origem do frontend
CORS_ORIGIN=http://localhost:5173

# --- Asterisk Manager Interface (AMI) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=dashboard
AMI_PASSWORD=changeme

# --- CDR (Call Detail Records) do FreePBX ---
# Usado para a série histórica de chamadas (recebidas/realizadas/perdidas/falhas)
CDR_HOST=127.0.0.1
CDR_PORT=3306
CDR_DATABASE=asteriskcdrdb
CDR_USER=freepbxuser
CDR_PASSWORD=changeme

# --- Banco `asterisk` (opcional, apenas para nome amigável do ramal) ---
# Deixe PBX_DB_HOST vazio para desativar (nomes caem para "Ramal <número>")
PBX_DB_HOST=127.0.0.1
PBX_DB_PORT=3306
PBX_DB_DATABASE=asterisk
PBX_DB_USER=freepbxuser
PBX_DB_PASSWORD=changeme

# --- Autenticação ---
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h
SQLITE_PATH=./data/dashboard.db

# --- Modo mock ---
# Se true (ou se a conexão com AMI/CDR falhar), o backend responde com dados
# simulados no mesmo formato dos endpoints reais, para permitir desenvolvimento
# do frontend sem um PBX real disponível.
FORCE_MOCK=false

# Limite (minutos) para considerar um ramal offline "há muito tempo" nos alertas
ALERT_EXTENSION_OFFLINE_MINUTES=120
# Limite (%) de uso de disco para gerar alerta
ALERT_DISK_USAGE_PERCENT=80

# Intervalo (ms) de verificação de alertas/saúde em background
MONITOR_INTERVAL_MS=15000
